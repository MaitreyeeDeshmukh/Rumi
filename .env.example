# Copy to .env.local (untracked) and fill in. Never commit real values.
# Names and placeholders only. Validated at startup by apps/web/src/lib/env.ts.

# Public (safe for the browser; protected by RLS, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
CARTESIA_API_KEY=
CARTESIA_VERSION=
SENTRY_DSN=

# Limits (server-side)
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_SPEND_CAP_USD=
