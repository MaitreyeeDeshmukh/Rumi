# Copy to apps/web/.env.local (untracked) and fill in. Never commit real values.
# Names and placeholders only. Validated lazily at first use by apps/web/src/lib/env.ts.

# Public (safe for the browser; protected by RLS, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Groq: all general AI (plan, practice clinician, help-me-say-it, recap) and speech to text
GROQ_API_KEY=
# Session cookie signing and memory namespace derivation. Random, 32 or more characters each.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
MEMORY_TAG_SECRET=
# Optional persona memory. The memory routes exist only when MEMORY_ENABLED=1.
SUPERMEMORY_API_KEY=
MEMORY_ENABLED=
# Optional spoken replies (text to speech). The browser voice is the default.
CARTESIA_API_KEY=
CARTESIA_VERSION=
SENTRY_DSN=

# Model IDs (not secret). Confirm they are still on Groq's production list on the day of use.
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STT=whisper-large-v3-turbo

# Limits (server-side)
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_SPEND_CAP_USD=

# Local development only. Serves fixtures, no model call. Must never exist in the production environment.
MOCK_AI=
# Local evals only. Relaxes limits. Ignored when NODE_ENV=production.
EVAL_MODE=
