# Copy to apps/web/.env.local (untracked) and fill in. Never commit real values.
# Names and placeholders only. Validated lazily at first use by apps/web/src/lib/env.ts.

# Public (safe for the browser; protected by RLS, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Groq: all general AI (plan, practice clinician, help-me-say-it, recap) and speech to text
GROQ_API_KEY=
# Session cookie signing (abuse limits only). Random, 32 or more characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Retired: persona memory now lives in Supabase and is switched by ops_feature_flags.memory_sync_enabled.
# Optional spoken replies (text to speech). The browser voice is the default.
CARTESIA_API_KEY=
CARTESIA_VERSION=
SENTRY_DSN=

# Model IDs (not secret). Confirm they are still on Groq's production list on the day of use.
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STT=whisper-large-v3-turbo

# Limits (server-side)
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_SPEND_CAP_USD=

# Local development only. Serves fixtures, no model call. Must never exist in the production environment.
MOCK_AI=
# Local evals only. Relaxes limits. Ignored when NODE_ENV=production.
EVAL_MODE=

# Added at integration (production readiness). Placeholders only.
SUPABASE_SECRET_KEY=your-supabase-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
AUTH_PROXY_REFRESH=on
AI_DAILY_ANON_LIMIT=20
AI_FORCE_OFF=0
ALLOW_MOCK_IN_PROD=0
READY_TOKEN=your-ready-token
RELEASE=local
TELEMETRY_DB_WRITES=on
# Optional. Evals only (EVAL_MODE=1, never in production): replaces the built-in prompt-leak marker. 8 to 64 letters, digits, _ or -.
# EVAL_CANARY=
# Optional. Alert job only: milliseconds to wait between the two /api/ready probes (default 5000). Tests use a small value.
# READY_RETRY_MS=5000
