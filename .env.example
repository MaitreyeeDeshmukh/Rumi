# Copy to .env.local (untracked) and fill in. Never commit real values.
# Names and placeholders only. Validated at startup by apps/web/src/lib/env.ts.

# Public (safe for the browser; protected by RLS, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Groq: all general AI (plan, practice clinician, help-me-say-it, recap)
GROQ_API_KEY=
# Wispr Flow: voice input (speech to text). Server holds the key; browser gets short-lived tokens.
WISPR_FLOW_API_KEY=
# Cartesia: spoken replies (text to speech)
CARTESIA_API_KEY=
CARTESIA_VERSION=
SENTRY_DSN=

# Model IDs (not secret). Verified against Groq's production model list.
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STT=whisper-large-v3-turbo

# Limits (server-side)
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_SPEND_CAP_USD=
