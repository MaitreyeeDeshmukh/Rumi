#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

bash "$root/scripts/check-no-stray-md.sh"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config "$root/.gitleaks.toml"
else
  echo "warning: gitleaks not installed; secret scan skipped locally (CI still scans). Install: https://github.com/gitleaks/gitleaks" >&2
fi
